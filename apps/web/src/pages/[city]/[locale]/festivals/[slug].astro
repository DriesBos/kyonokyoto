---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Footer from '../../../../components/Footer.astro';
import GeneralButton from '../../../../components/GeneralButton.astro';
import kyotoSourcesPayload from '../../../../../../../data/sources/kyoto-sources.json';
import osakaSourcesPayload from '../../../../../../../data/sources/osaka-sources.json';
import tokyoSourcesPayload from '../../../../../../../data/sources/tokyo-sources.json';
import hongKongSourcesPayload from '../../../../../../../data/sources/hong-kong-sources.json';
import { cityConfigFor, dateOnlyInTimeZone, type AppCity } from '../../../../lib/cities';
import { normalizeLocale } from '../../../../lib/i18n';
import {
  calendarDetailsFor,
  calendarLocationFor,
  cleanDisplayText,
  formatEventDateRange,
  googleCalendarUrl,
} from '../../../../lib/calendar';
import { fetchPublishedEvents, localizeEvent, type EventRow } from '../../../../lib/events';
import { eventMediaDeliverySrcSet, eventMediaDeliveryUrl } from '../../../../lib/mediaDelivery';
import {
  configuredSourcesFrom,
  sourceDisplayNameForEvent,
  sourceSlugForEvent,
  type SourceConfig,
} from '../../../../lib/sources';

export const prerender = false;

const cityConfig = cityConfigFor(Astro.params.city);
const locale = normalizeLocale(Astro.params.locale);
const slug = Astro.params.slug;
if (!cityConfig || !locale || !slug) return new Response('Not found', { status: 404 });

const city = cityConfig.slug;
const rawEvents = await fetchPublishedEvents({ city, locale });
const festivalRaw = rawEvents.find(
  (row) => row.event_kind === 'festival' && row.festival_slug === slug,
);
if (!festivalRaw) return new Response('Not found', { status: 404 });

const festival = localizeEvent(
  {
    ...festivalRaw,
    date_text: festivalRaw.date_text ?? '',
    institution_name: festivalRaw.institution_name ?? '',
    source_url: festivalRaw.source_url ?? '',
  } as EventRow,
  locale,
);
const sourcesPayloadByCity = {
  kyoto: kyotoSourcesPayload,
  osaka: osakaSourcesPayload,
  tokyo: tokyoSourcesPayload,
  'hong-kong': hongKongSourcesPayload,
} satisfies Record<AppCity, { sources: SourceConfig[] }>;
const configuredSources = configuredSourcesFrom(
  sourcesPayloadByCity[city].sources as SourceConfig[],
);
if (!sourceSlugForEvent(festival, configuredSources))
  return new Response('Not found', { status: 404 });

const today = dateOnlyInTimeZone(new Date(), cityConfig.timeZone);
const festivalName = sourceDisplayNameForEvent(festival, configuredSources, locale);
const festivalDate = formatEventDateRange(
  festival.start_date,
  festival.end_date,
  festival.date_text,
  locale,
);
const festivalYear =
  festival.start_date?.slice(0, 4) ?? festival.date_text.match(/20\d{2}/)?.[0] ?? '';
const pagePath = `/${city}/${locale}/festivals/${encodeURIComponent(slug)}/`;
const alternatePaths = {
  en: `/${city}/en/festivals/${encodeURIComponent(slug)}/`,
  ja: `/${city}/ja/festivals/${encodeURIComponent(slug)}/`,
};
const pageDescription = cleanDisplayText(festival.description ?? '');
const copy =
  locale === 'ja'
    ? {
        events: 'イベント',
        year: '年',
        website: 'フェスティバル公式サイト',
        apple: 'Appleカレンダーに追加',
        google: 'Googleカレンダーに追加',
        imageAlt: 'フェスティバルの画像',
      }
    : {
        events: 'events',
        year: '',
        website: 'Festival website',
        apple: 'Add to Apple Calendar',
        google: 'Add to Google Calendar',
        imageAlt: 'Festival image',
      };

const imageUrls = [festival.primary_image_url, ...(festival.image_urls ?? [])]
  .filter((url, index, urls): url is string => Boolean(url) && urls.indexOf(url) === index)
  .slice(0, 5);
const images = imageUrls.flatMap((sourceUrl) => {
  const src = eventMediaDeliveryUrl(sourceUrl);
  const srcset = eventMediaDeliverySrcSet(sourceUrl);
  if (!src || !srcset) return [];
  const metadata = festival.image_metadata?.find((image) => image.url === sourceUrl);
  return [{ sourceUrl, src, srcset, width: metadata?.width, height: metadata?.height }];
});
const cover = images[0] ?? null;
const previews = images.slice(1, 5);

const calendarEvent = {
  ...festival,
  calendar_starts_at: festival.calendar_starts_at ?? festival.start_date,
  calendar_ends_at: festival.calendar_ends_at ?? festival.end_date,
  schedule_type: 'range' as const,
  schedule_segments: null,
};
const calendarStart = calendarEvent.calendar_starts_at ?? '';
const calendarEnd = calendarEvent.calendar_ends_at ?? '';
const showAppleCalendar = Boolean(calendarStart && calendarEnd);
const calendarDetails = calendarDetailsFor(calendarEvent);
const calendarLocation = calendarLocationFor(calendarEvent);
const googleUrl = googleCalendarUrl(calendarEvent, today);
const pageTitle = festival.title;
---

<BaseLayout
  city={city}
  cityThemeColor={cityConfig.themeColor}
  locale={locale}
  title={`${pageTitle} | Kyō no Kyōto`}
  description={pageDescription || `${pageTitle} festival`}
  canonicalPath={pagePath}
  alternatePaths={alternatePaths}
>
  <main class="festival-page">
    <nav aria-label="Breadcrumb">
      <a href={`/${city}/${locale}/`}>{cityConfig.label} {copy.events}</a>
    </nav>
    <header class="festival-page__header">
      <p class="festival-page__name">{festivalName}</p>
      {
        festivalYear ? (
          <p class="festival-page__year">
            {festivalYear}
            {copy.year}
          </p>
        ) : null
      }
      <p class="festival-page__date">{festivalDate}</p>
      <h1>{festival.title}</h1>
      {pageDescription ? <p class="festival-page__description">{pageDescription}</p> : null}
      <div class="festival-page__actions">
        {
          showAppleCalendar ? (
            <GeneralButton
              edge="first"
              verticalPadding="full"
              label={copy.apple}
              icon="calendar"
              data-apple-calendar-button
              data-calendar-title={festival.title}
              data-calendar-start={calendarStart}
              data-calendar-end={calendarEnd}
              data-calendar-all-day={String(festival.is_all_day)}
              data-calendar-details={calendarDetails}
              data-calendar-location={calendarLocation}
            />
          ) : null
        }
        {
          googleUrl ? (
            <GeneralButton
              edge={showAppleCalendar ? undefined : 'first'}
              verticalPadding="full"
              label={copy.google}
              icon="calendar"
              href={googleUrl}
              target="_blank"
              rel="noreferrer"
            />
          ) : null
        }
        {
          festival.source_url ? (
            <GeneralButton
              edge="last"
              verticalPadding="full"
              label={copy.website}
              icon="exit"
              href={festival.source_url}
              target="_blank"
              rel="noreferrer"
            />
          ) : null
        }
      </div>
    </header>

    {
      cover ? (
        <section class="festival-page__gallery" aria-label={copy.imageAlt}>
          <a
            class="festival-page__cover"
            href={festival.source_url || undefined}
            target={festival.source_url ? '_blank' : undefined}
            rel={festival.source_url ? 'noreferrer' : undefined}
            aria-label={festival.source_url ? copy.website : undefined}
          >
            <img
              src={cover.src}
              srcset={cover.srcset}
              sizes="(max-width: 767px) 100vw, 72rem"
              width={cover.width ?? undefined}
              height={cover.height ?? undefined}
              alt={festival.title}
              fetchpriority="high"
              decoding="async"
            />
          </a>
          {previews.length ? (
            <div class="festival-page__previews">
              {previews.map((image, index) => (
                <a
                  href={festival.source_url || undefined}
                  target={festival.source_url ? '_blank' : undefined}
                  rel={festival.source_url ? 'noreferrer' : undefined}
                  aria-label={festival.source_url ? copy.website : undefined}
                >
                  <img
                    src={image.src}
                    srcset={image.srcset}
                    sizes="(max-width: 767px) 50vw, 18rem"
                    width={image.width ?? undefined}
                    height={image.height ?? undefined}
                    alt={`${festival.title} ${index + 1}`}
                    loading="lazy"
                    decoding="async"
                  />
                </a>
              ))}
            </div>
          ) : null}
        </section>
      ) : null
    }
    <Footer cityLabel={cityConfig.label} />
  </main>
</BaseLayout>

<style lang="sass">
  .festival-page
    max-width: 72rem
    min-height: 100svh
    margin: auto
    padding: 2rem var(--page-padding-x)

    nav
      margin-bottom: clamp(3rem, 8vw, 7rem)

    a
      color: inherit
      text-decoration: underline
      text-underline-offset: 0.2em

    &__header
      max-width: 54rem
      margin-bottom: clamp(3rem, 7vw, 6rem)

    &__name,
    &__year,
    &__date
      margin: 0.3rem 0
      text-transform: uppercase

    h1
      font-size: clamp(3rem, 8vw, 8rem)
      line-height: 0.95
      margin: 1rem 0 2rem

    &__description
      max-width: 45rem
      white-space: pre-line

    &__actions
      display: flex
      flex-wrap: wrap
      gap: 0.75rem
      margin-top: 2rem

    &__gallery
      margin-bottom: clamp(4rem, 10vw, 8rem)

    &__cover,
    &__previews a
      display: block
      overflow: hidden

    &__cover
      aspect-ratio: 16 / 9
      background: var(--surface, #eee)

      img
        width: 100%
        height: 100%
        object-fit: cover

    &__previews
      display: grid
      grid-template-columns: repeat(4, minmax(0, 1fr))
      gap: 0.75rem
      margin-top: 0.75rem

      a
        aspect-ratio: 4 / 3
        background: var(--surface, #eee)

      img
        width: 100%
        height: 100%
        object-fit: cover

    @media (max-width: 767px)
      &__previews
        grid-template-columns: repeat(2, minmax(0, 1fr))
</style>

<script>
  import { initAppleCalendar } from '../../../../scripts/appleCalendar';

  initAppleCalendar();
</script>
